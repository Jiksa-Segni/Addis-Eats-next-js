# ─────────────────────────────────────────────────────────────────────────────
# Addis Eats — Environment Variables
#
# Copy this file to .env.local and fill in the real values before running
# the application locally or deploying to production.
#
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication (required) ─────────────────────────────────────────────────

# Long random secret used to sign HMAC-SHA-256 session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. In development a hardcoded fallback is used (insecure).
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# ── Admin account (required for staff sign-in) ────────────────────────────────

# The phone number used by the admin/staff account.
# Must be a valid Ethiopian format: 09xxxxxxxx or +2519xxxxxxxx
ADMIN_PHONE=0911111111

# The password for the admin account. Use a strong password in production.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional display name shown in the navigation bar for the admin user.
# Defaults to "Admin" if not set.
ADMIN_NAME=Admin

# ── Public site URL (recommended) ─────────────────────────────────────────────

# The canonical public URL of your deployment, e.g. https://addis-eats.vercel.app
# Used for generating absolute URLs in sitemaps, Open Graph metadata, and
# JSON-LD structured data.
# If deploying on Vercel, VERCEL_URL is set automatically for preview deployments.
# Set NEXT_PUBLIC_SITE_URL to your production custom domain when you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
